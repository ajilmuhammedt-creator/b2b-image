# Environment Variables
# Copy to .env.local for local development

# Browser Environment Variables (Safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key_here

# Server Environment Variables (DO NOT expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here
OPENAI_API_KEY=your_openai_api_key_here
CRON_SECRET=your_cron_secret_here
