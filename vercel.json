{
  "functions": {
    "api/*.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "30 20 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
